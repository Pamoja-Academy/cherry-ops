# Cherry Ops — environment configuration
# Copy to .env.local for local development.

# NextAuth v5 session/JWT secret (required in production)
# Generate with: openssl rand -base64 32
AUTH_SECRET="cherry-ops-secret-2026-contest"

# Database location (SQLite file for demo; swap for Postgres/Supabase in Phase 2)
DATABASE_URL="./data/cherry-ops.db"

# Canonical app URL (used by NextAuth in production)
# NEXTAUTH_URL="https://cherry-ops.vercel.app"

# Protects the /api/autopilot/run cron endpoint (Vercel sends CRON_SECRET as Bearer token)
# CRON_SECRET="change-me-in-production"
